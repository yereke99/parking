# TEST FIXTURE for the SIMULATED camera LAN (tests/camera_sim). Committed on purpose.
# These are the logins of the fake cameras that sim.sh starts in Docker. They are NOT real
# credentials of any camera and must never be used on real devices; real operator secrets
# belong in config/cameras.env (gitignored).
#
# Format: one KEY=value per line, no quotes (read by `docker run --env-file` and by sim.sh).
# The names match what kz_anpr camera mode reads, so `sim.sh run` passes this file unchanged.
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=Sim-pass_123
# The separate ONVIF account of the ONVIF-enabled simulated camera (cam2).
ONVIF_USERNAME=onvifuser
ONVIF_PASSWORD=Sim-onvif_456
# cam4 deliberately uses another password, so the shared credentials above fail on it
# (the RTSP_AUTH_FAILED scenario). kz_anpr never reads this variable.
SIM_CAM4_PASSWORD=other
