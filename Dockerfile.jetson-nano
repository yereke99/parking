# Jetson Nano 4 GB / JetPack 4.6.x / L4T R32.7.x only. Build this image on the Jetson:
#   make docker-build
# The digest pins CUDA 10.2, PyTorch 1.10, OpenCV 4.5 and the JetPack Python 3.6 ABI.
#
# CUDA, cuDNN and TensorRT are deliberately NOT installed in this image. On JetPack 4 the NVIDIA
# container runtime bind-mounts the host's copies (libraries, headers, nvcc) read-only into every
# container, and into every RUN step when Docker's default runtime is nvidia. dpkg cannot install
# those packages over the mounts, so the builder compiles against the mounted host files and
# `docker run --runtime nvidia` supplies the same libraries at run time.
# tools/jetson_docker.sh checks both preconditions before building.
ARG L4T_ML_IMAGE=nvcr.io/nvidia/l4t-ml:r32.7.1-py3@sha256:238be76a09a10904b6b9d3cfca5cd2b34c369a3c3c99340050f825998f552a5b

# --------------------------------------------------------------------------------------------
# C++ build: kz_anpr, kz_anpr_benchmark and their unit tests.
# --------------------------------------------------------------------------------------------
FROM ${L4T_ML_IMAGE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG ONNXRUNTIME_VERSION=1.11.1
ARG ONNXRUNTIME_SHA256=bb9ca658a6a0acc7b9e4288647277a9ce9d86b063a2403a51d5c0d2e4df43603

# The GStreamer headers let camera mode drive its appsink directly (bounded reads, the bus error
# text, I420 frames from the hardware converter) instead of through OpenCV. They are Ubuntu
# 18.04's own 1.14.5 packages: the version of the GStreamer runtime this image already has from
# l4t-base, and the one NVIDIA built nvv4l2decoder and nvvidconv against. The runtime stage
# needs nothing new. pkg-config fails the build here rather than letting CMake quietly fall back
# to OpenCV capture.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential ca-certificates cmake curl pkg-config \
        libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pkg-config --exists 'gstreamer-1.0 >= 1.14' 'gstreamer-app-1.0' 'gstreamer-video-1.0'

COPY tools/docker/fetch-verified.sh /usr/local/bin/fetch-verified

# Microsoft's aarch64 CPU package of ONNX Runtime: only the fallback for a model TensorRT refuses.
# The detector and the OCR run on the host's native TensorRT 8.2 and CUDA 10.2.
RUN fetch-verified \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/onnxruntime-linux-aarch64-${ONNXRUNTIME_VERSION}.tgz" \
        "${ONNXRUNTIME_SHA256}" /tmp/onnxruntime.tgz \
    && mkdir -p /opt/onnxruntime \
    && tar -xzf /tmp/onnxruntime.tgz -C /opt/onnxruntime --strip-components=1 \
    && rm /tmp/onnxruntime.tgz

# Only the C++ build and test inputs, so edits elsewhere do not invalidate the single-job build.
WORKDIR /src
COPY CMakeLists.txt /src/
COPY include /src/include
COPY src /src/src
COPY tests /src/tests
COPY config /src/config
RUN mkdir -p /tmp/build \
    && cd /tmp/build \
    && cmake /src \
        -DCMAKE_BUILD_TYPE=Release \
        -DONNXRUNTIME_ROOT=/opt/onnxruntime \
        -DKZ_ANPR_WITH_TENSORRT=ON \
        -DKZ_ANPR_REQUIRE_TENSORRT=ON \
        -DKZ_ANPR_BUILD_TESTS=ON \
    && cmake --build . -- -j1 \
    && ctest --output-on-failure

# --------------------------------------------------------------------------------------------
# Runtime: the two binaries, the ONNX Runtime fallback and Nomeroff's Kazakhstan OCR model.
# --------------------------------------------------------------------------------------------
FROM ${L4T_ML_IMAGE} AS runtime

ARG DEBIAN_FRONTEND=noninteractive
ARG NOMEROFF_KZ_SHA256=b8d09e77dc0d212cf4a9f266e2ba2b18bd655dfcb45582195d64d647ca37ac28

# The GStreamer core and base libraries (app/video) come with l4t-base already; naming them
# makes the binary's dependency explicit, and the ldd check below fails the build instead of
# shipping a kz_anpr that cannot start.
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl libgomp1 \
        libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Nomeroff Net 4.0.1's Kazakhstan text reader ("kz", model card nomeroff-net-ocr-kz/model-4.json).
# Nomeroff itself needs Python >= 3.9 and PyTorch >= 1.12, so the small network is rebuilt and
# exported to ONNX with this image's PyTorch 1.10 and runs in the C++ process on TensorRT.
# nomeroff.net.ua resets long transfers to the Nano, so the download resumes where it stopped. A
# copy placed at models/nomeroff/anpr_ocr_kz_2022_11_14.ckpt in the checkout is used instead when
# its SHA-256 matches (the script is listed too, so the wildcard may match nothing).
COPY tools/docker/fetch-resumable.sh models/nomeroff/*.ckpt /tmp/nomeroff/
COPY tools/export_nomeroff_onnx.py /opt/kz-anpr/tools/
RUN sh /tmp/nomeroff/fetch-resumable.sh \
        https://nomeroff.net.ua/models/ocr/kz/torch/model_v3.3/anpr_ocr_kz_2022_11_14.ckpt \
        "${NOMEROFF_KZ_SHA256}" /tmp/anpr_ocr_kz_2022_11_14.ckpt \
        /tmp/nomeroff/anpr_ocr_kz_2022_11_14.ckpt \
    && /usr/bin/python3 /opt/kz-anpr/tools/export_nomeroff_onnx.py \
        --checkpoint /tmp/anpr_ocr_kz_2022_11_14.ckpt \
        --output /opt/kz-anpr/models/nomeroff-onnx/kz.onnx \
    && rm -rf /tmp/anpr_ocr_kz_2022_11_14.ckpt /tmp/nomeroff

COPY --from=builder /opt/onnxruntime/lib/ /opt/onnxruntime/lib/
COPY --from=builder /tmp/build/kz_anpr /opt/kz-anpr/bin/kz_anpr
COPY --from=builder /tmp/build/kz_anpr_benchmark /opt/kz-anpr/bin/kz_anpr_benchmark
RUN if LD_LIBRARY_PATH=/opt/onnxruntime/lib:${LD_LIBRARY_PATH} ldd /opt/kz-anpr/bin/kz_anpr \
        | grep 'not found'; then \
        echo "kz_anpr has unresolved shared libraries (above)" >&2; exit 1; \
    fi

ENV LD_LIBRARY_PATH=/opt/onnxruntime/lib:${LD_LIBRARY_PATH} \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

# tools/jetson_docker.sh refuses to run an image built from an older checkout layout.
LABEL kz-anpr.layout="cameras-1"

WORKDIR /workspace
CMD ["/opt/kz-anpr/bin/kz_anpr", "--config", "/workspace/config/jetson-nano.yaml"]
