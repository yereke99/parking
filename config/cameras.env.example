# Camera credentials for camera mode (config/cameras.yaml).
#
# Copy this file to config/cameras.env (gitignored), put the real passwords there and restrict it:
#   cp config/cameras.env.example config/cameras.env && chmod 600 config/cameras.env
# NEVER commit config/cameras.env. It is passed to the container with `docker run --env-file`, so
# write plain KEY=value lines: no quotes, no spaces around '=', no `export`.
#
# Check the values before starting: a rejected login is retried only every 15 minutes and at
# most twice, because Hikvision locks an address out for 30 minutes after a few failed logins.

# Login used for every camera.
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=change-me

# One camera with its own login: the camera id from `make camera-scan`, upper-cased, '-' as '_'.
# HIKVISION_USERNAME_CAMERA_02=admin
# HIKVISION_PASSWORD_CAMERA_02=other-password

# Variables named by username_env / password_env in a camera entry of config/cameras.yaml.
# GATE_EXIT_USERNAME=operator
# GATE_EXIT_PASSWORD=another-password

# Optional ONVIF account (a separate user on Hikvision), only for reading device details.
# ONVIF_USERNAME=onvif
# ONVIF_PASSWORD=onvif-password
