# Builds
build/
build-*/
cmake-build-*/

# Models are downloaded or exported, never committed (models/README.md)
*.onnx
*.engine
*.plan
models/nomeroff/

# Runtime state: TensorRT engine cache, events.jsonl, camera registry and status
var/

# Camera passwords (config/cameras.env and any other env file under config/); the template
# config/cameras.env.example is tracked
config/**/*.env
!config/cameras.env.example

# Generated video copies; original test clips are tracked
/video/compatible/
debug_frames/
debug_crops/

# Left behind by the research setup (research-archive branch)
benchmark_results/
benchmark_cache/
models/trt_cache/
models/research/
data/raw/
data/processed/
*.param
*.bin

# Local tooling
.venv*/
__pycache__/
*.pyc
*.log
*.tmp
/test-output/
.DS_Store
