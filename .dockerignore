# Allowlist: only what Dockerfile.jetson-nano copies. Videos, the detector model and runtime state
# are mounted at run time, so they stay out of the build context.
*
!CMakeLists.txt
!config/
!include/
!models/nomeroff/*.ckpt
!src/
!tests/
!tools/
# Camera passwords never enter the build context, although config/ is allowed above.
config/**/*.env
**/*.env
**/__pycache__
**/*.pyc
**/.DS_Store
tests/camera_sim/.cache
